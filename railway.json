{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "docker/Dockerfile",
    "watchPatterns": [
      "src/**",
      "migrations/**",
      "scripts/**",
      "docker/**",
      "alembic.ini",
      "pyproject.toml",
      "poetry.lock",
      "railway.json"
    ]
  },
  "deploy": {
    "preDeployCommand": "/usr/local/bin/entrypoint.sh migrate",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "numReplicas": 1,
    "requiredMountPath": "/data",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "overlapSeconds": 15,
    "drainingSeconds": 20,
    "sleepApplication": false
  },
  "environments": {
    "staging": {
      "deploy": {
        "sleepApplication": true,
        "overlapSeconds": 0
      }
    }
  }
}
